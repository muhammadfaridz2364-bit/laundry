# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Port aplikasi dan origin publik (dipakai untuk cookie Secure dan pengecekan Origin).
PORT=3000
APP_ORIGIN=http://localhost:3000

# Wajib: minimal 32 karakter acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Koneksi MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_PASSWORD boleh dikosongkan: `npm run db:setup` akan menanyakannya
# sekali lalu menyimpannya ke file .env ini.
DB_USER=root
DB_PASSWORD=
DB_NAME=laundry_zahra
DB_CONNECTION_LIMIT=10

# Akun admin yang dibuat oleh `npm run db:setup`.
SEED_ADMIN_EMAIL=admin@laundryzahra.test
SEED_ADMIN_PASSWORD=

# Data demo (penjual + pembeli + 8 produk contoh). Set false untuk produksi.
SEED_DEMO=true
SEED_DEMO_SELLER_EMAIL=seller@laundryzahra.test
SEED_DEMO_BUYER_EMAIL=buyer@laundryzahra.test
SEED_DEMO_PASSWORD=Demo#2026LZ
