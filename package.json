{
  "name": "laundry-zahra",
  "version": "1.0.0",
  "private": true,
  "description": "Katalog & dashboard Laundry Zahra (admin, penjual, pembeli) dengan MySQL",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "db:setup": "node --env-file-if-exists=.env db/setup.js",
    "db:dummy": "node --env-file-if-exists=.env db/dummy.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  }
}
